# Line endings: store and check out text files as LF on every OS so Git never warns
# "LF will be replaced by CRLF" (system git config here has core.autocrlf=true).
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.woff binary
*.woff2 binary
*.ttf binary
