<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProMaxx2.QA.Application\ProMaxx2.QA.Application.csproj" />
    <ProjectReference Include="..\ProMaxx2.QA.Domain\ProMaxx2.QA.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <!-- Microsoft.Data.SqlClient 6.1.1 ดึง Pkcs 9.0.4 ซึ่งมีช่องโหว่ CVE-2026-84008 / CVE-2026-70162 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, ประกาศ 2026-10-13)
         TreatWarningsAsErrors ทำให้ restore ล้ม — อ้างอิงเวอร์ชันที่แก้แล้วโดยตรง ลบได้เมื่อ SqlClient/EF Core อัปเดต dependency เอง -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
